{
  "realm": "myelin",
  "displayName": "RAT Flea DevSec",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(14) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "browserFlow": "myelin browser step-up",
  "attributes": {
    "acr.loa.map": "{\"pwd\": 1, \"mfa\": 2}"
  },
  "roles": {
    "realm": [
      {
        "name": "myelin-tenant-admin",
        "description": "Tenant administrator"
      },
      {
        "name": "myelin-security-lead",
        "description": "Security lead / AppSec"
      },
      {
        "name": "myelin-developer",
        "description": "Developer"
      },
      {
        "name": "myelin-auditor",
        "description": "Auditor (read + evidence review)"
      },
      {
        "name": "myelin-viewer",
        "description": "Read-only viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "myelin-console",
      "name": "RAT Flea DevSec Console (BFF)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MYELIN_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://myelin.localtest.me:8443/auth/callback",
        "https://myelin.example.com/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "default.acr.values": "mfa",
        "minimum.acr.value": "mfa",
        "post.logout.redirect.uris": "https://myelin.localtest.me:8443/##https://myelin.example.com/"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-myelin-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "myelin-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "basic"
      ]
    },
    {
      "clientId": "myelin-api",
      "name": "RAT Flea DevSec API (audience)",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    }
  ],
  "authenticationFlows": [
    {
      "alias": "myelin browser step-up",
      "description": "Password at LoA 1, OTP/WebAuthn at LoA 2 (acr=mfa)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "myelin auth forms"
        }
      ]
    },
    {
      "alias": "myelin auth forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "myelin loa1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "myelin loa2"
        }
      ]
    },
    {
      "alias": "myelin loa1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "myelin loa2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "0"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"tenant\", \"displayName\": \"RAT Flea DevSec tenant\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"validations\": {\"pattern\": {\"pattern\": \"^[a-z0-9-]{2,40}$\", \"error-message\": \"tenant slug\"}}}]}"
          ]
        }
      }
    ]
  },
