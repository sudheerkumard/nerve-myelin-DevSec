# Enterprise Compose stack secrets. Generate real values:  scripts/ops/gen-secrets.sh > config/backend/enterprise.env
# The real file is git-ignored. In Kubernetes these live in a vault and reach pods through ExternalSecrets.
MYELIN_DB_OWNER_PASSWORD=
MYELIN_DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
MYELIN_OIDC_CLIENT_SECRET=
MYELIN_SESSION_SECRET=
MYELIN_API_KEY_PEPPER=
MYELIN_EVIDENCE_SIGNING_KEY=
# Licence key issued for RAT Flea DevSec (NMLIC1.…). Without it the platform runs read-only (restricted).
MYELIN_LICENSE=

# Independent advisory worker (optional Compose profile: --profile worker).
# Populate with comma-separated tenant UUIDs provisioned for this deployment before enabling the worker.
MYELIN_WORKER_TENANT_IDS=
MYELIN_WORKER_POLL_SECONDS=5
MYELIN_WORKER_LEASE_SECONDS=900
MYELIN_WORKER_MAX_ATTEMPTS=5
# Optional higher-rate vendor API credentials; keep these in the secret manager in production.
NVD_API_KEY=
GITHUB_ADVISORY_TOKEN=
