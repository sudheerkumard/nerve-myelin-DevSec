# NERvvE DevSecOps — customer live-demo settings (sample tenant, open read-only access on localhost only).
MYELIN_API_KEYS=nm_demo_9f2c41e7b8
MYELIN_DEMO_OPEN=true
MYELIN_CORS=http://localhost:8080,http://127.0.0.1:8080
MYELIN_TENANT_NAME=Orion Financial Group
MYELIN_TENANT_PLAN=enterprise
MYELIN_TENANT_DEVS=640
MYELIN_TENANT_REGION=Azure Central India
MYELIN_TENANT_SSO=Entra ID (SAML)
MYELIN_SEED_DEMO_DATA=true
MYELIN_POLICY_FILE=
MYELIN_LOG_LEVEL=info

# --- Mode -----------------------------------------------------------------
# demo = in-memory sample tenant; enterprise = PostgreSQL + OIDC + row-level security
MYELIN_MODE=demo

