# NERvvE DevSecOps platform API — production settings template.
# Copy to config/backend/myelin.env (git-ignored) or inject as environment variables / Kubernetes secrets.

# --- Mode -----------------------------------------------------------------
# demo = in-memory sample tenant; enterprise = PostgreSQL + OIDC + row-level security
MYELIN_MODE=enterprise

# --- Security -------------------------------------------------------------
# Demo mode only: static API keys. Enterprise mode issues per-tenant, hashed, expiring keys via POST /api/v1/api-keys.
MYELIN_API_KEYS=nm_REPLACE_WITH_RANDOM_KEY
# Read-only access without a key. MUST be false outside demonstrations.
MYELIN_DEMO_OPEN=false
# Allowed console origins (comma-separated)
MYELIN_CORS=https://myelin.customer.example

# --- Tenant ---------------------------------------------------------------
MYELIN_TENANT_NAME=Customer Name
# community | team | business | enterprise | sovereign
MYELIN_TENANT_PLAN=business
MYELIN_TENANT_DEVS=250
MYELIN_TENANT_REGION=Azure Central India
MYELIN_TENANT_SSO=Entra ID (SAML)

# --- Data and policy ------------------------------------------------------
# true only for demo environments
MYELIN_SEED_DEMO_DATA=false
MYELIN_POLICY_FILE=policies/myelin-policy.yaml
MYELIN_LIVE_SCAN_ROOT=/opt/myelin/demo

# --- Runtime --------------------------------------------------------------
MYELIN_LOG_LEVEL=info

# --- Enterprise mode -------------------------------------------------------
# App connection uses the least-privilege login (member of myelin_app, NOBYPASSRLS). TLS required.
MYELIN_DATABASE_URL=postgresql+psycopg://myelin_api:REPLACE@db.customer.example:5432/myelin?sslmode=verify-full
# Owner connection — used only by `myelin migrate` and `myelin admin`, never by the running API.
MYELIN_MIGRATIONS_DATABASE_URL=postgresql+psycopg://myelin_owner:REPLACE@db.customer.example:5432/myelin?sslmode=verify-full
MYELIN_IDP_CONFIG=/etc/myelin/identity-providers.yaml
MYELIN_PUBLIC_URL=https://myelin.customer.example
# Secret references (env://, file://, azkv://, awssm://, vault://). Defaults read the variables named below.
MYELIN_SESSION_SECRET_REF=env://MYELIN_SESSION_SECRET
MYELIN_API_KEY_PEPPER_REF=env://MYELIN_API_KEY_PEPPER
MYELIN_EVIDENCE_SIGNING_KEY_REF=env://MYELIN_EVIDENCE_SIGNING_KEY
# Evidence store location: s3://bucket/prefix?region=…, azblob://account/container/prefix, file:///path
MYELIN_EVIDENCE_STORE=s3://myelin-evidence/evidence?region=ap-south-1
MYELIN_SESSION_IDLE_MINUTES=30
MYELIN_SESSION_ABSOLUTE_HOURS=12
MYELIN_METRICS_ENABLED=true
# Licence: secret reference to the NMLIC1.… key issued for NERvvE DevSecOps; optional installation binding
MYELIN_LICENSE_REF=env://MYELIN_LICENSE
MYELIN_DEPLOYMENT_ID=
